{
  "name": "repbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:exercise-directory && tsc -b && vite build && node scripts/prepare-sites-dist.mjs",
    "build:exercise-directory": "node scripts/build-bilingual-exercise-directory.mjs",
    "check:exercise-directory": "node scripts/build-bilingual-exercise-directory.mjs --check",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=2 && node --test scripts/prepare-sites-dist.node-test.mjs",
    "test:exercise-directory": "node --test scripts/build-bilingual-exercise-directory.node-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
